[Remote Filter]
全部_Filter = NameRegex, FilterKey = ".*"
香港_Filter = NameRegex, FilterKey = "(?i)(港|HK|香港|🇭🇰|Hong)"
台湾_Filter = NameRegex, FilterKey = "(?i)(台|TW|台湾|Tai)"
日本_Filter = NameRegex, FilterKey = "(?i)(日本|川日|东京|日本|🇯🇵|大阪|泉日|埼玉|沪日|深日|JP|Japan)"
韩国_Filter = NameRegex, FilterKey = "(?i)(KR|Korea|KOR|首尔|韩国|🇰🇷|韩|韓)"
美国_Filter = NameRegex, FilterKey = "(?i)(美|波特兰|美国|🇺🇸|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States)"
新加坡_Filter = NameRegex, FilterKey = "(?i)(新加坡|坡|新加坡|🇸🇬|狮城|SG|Singapore)"
国内_Filter = NameRegex, FilterKey = "广州"
冷门_Filter = NameRegex, FilterKey = "^(?!.*(港|HK|Hong|台|台湾|香港|美国|韩国|新加坡|🇭🇰|🇯🇵|🇰🇷|🇺🇸|🇸🇬|TW|Tai|🇨🇳 Taiwan|🇸🇬 Singapore|🇯🇵 Japan|日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|CN|中国|🇨🇳|深圳|北京|上海|广州移动|Japan|KR|Korea|KOR|首尔|韩|韓|美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States|新加坡|坡|狮城|SG|Singapore)).*$"

